{
  "include": ["./src/**/*", "./lib/**/*"],
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "strict": true,
    "composite": true,
    "noEmit": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "allowJs": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "types": ["vitest/globals"]
  }
}
