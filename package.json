{
  "name": "@numiko/scroll-lock",
  "description": "Scroll Lock",
  "version": "2.1.0",
  "type": "module",
  "engines": {
    "node": ">=26.12.1"
  },
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/numiko/scroll-lock.git"
  },
  "homepage": "https://github.com/numiko/scroll-lock#readme",
  "bugs": {
    "url": "https://github.com/numiko/scroll-lock/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "vitest --run --reporter junit --outputFile ./reports/results.xml --coverage.enabled --coverage.include lib --coverage.reporter=html --coverage.reportsDirectory ./reports/",
    "generate-docs": "typedoc lib/ScrollLock.ts",
    "deploy-docs": "netlify deploy --dir=docs --site=038411fb-2574-4e29-91ab-fb24adb57dc3 --alias=v$(node -p \"require('./package.json').version\") && netlify deploy --dir=docs --site=038411fb-2574-4e29-91ab-fb24adb57dc3 --prod",
    "release": "echo 'Releasing package. Ensure the module is linked to the Netlify project using `netlify link`.'; release-it release"
  },
  "main": "./dist/ScrollLock.umd.js",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/ScrollLock.d.ts",
      "import": "./dist/ScrollLock.es.js",
      "require": "./dist/ScrollLock.umd.js"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@j-ulrich/release-it-regex-bumper": "^5.6.0",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.2",
    "globals": "^17.10.0",
    "happy-dom": "^21.0.4",
    "netlify-cli": "^27.16.2",
    "release-it": "^21.0.2",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.52.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-eslint": "^1.8.1",
    "vitest": "^5.0.5"
  },
  "release-it": {
    "$schema": "https://unpkg.com/release-it/schema/release-it.json",
    "plugins": {
      "@j-ulrich/release-it-regex-bumper": {
        "out": [
          {
            "file": "README.md",
            "search": "\\d+-\\d+-\\d+",
            "replace": "{{major}}-{{minor}}-{{patch}}"
          }
        ]
      }
    },
    "npm": {
      "publish": true,
      "publishArgs": [
        "--access",
        "public"
      ]
    },
    "hooks": {
      "before:init": [
        "vitest run"
      ],
      "after:bump": [
        "npm run generate-docs",
        "npm run build",
        "npm run deploy-docs"
      ]
    }
  }
}
